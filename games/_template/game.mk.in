# @NAME@ (games/@ID@): its make targets, included by the root Makefile.
#
#   make @ID@                host builds: @ID@ (SDL2), @ID@_headless, @ID@_libretro.so
#   make @ID@-check          all its tests (libretro loader, smoke + bot + determinism, UI screens, save states, audit)
#   make @ID@-dist           dist/windows/@EXE@.exe, dist/libretro/@ID@_libretro.so (+ .armhf.so)
#   make @ID@-windows        only the Windows exe
#   make @ID@-armhf          the libretro core for the RetroStone2 (Cortex-A7)
#   make @ID@-screenshots    games/@ID@/docs/screenshots/
#   make @ID@-art            redraw the code-drawn art (tools/make_art.py; commit art/)
#
# MIT licence, (c) 2026 Pierre-Louis Boyer (8BCraft): games/@ID@/LICENSE; the rules below follow the root Makefile.

@UP@_MAKE = $(MAKE) --no-print-directory GAME=@ID@ GAME_NAME=@EXE@
@UP@_DIR  = games/@ID@
# the house style kit (games/common/src, docs/art-direction.md) is compiled in
HOUSE_UI_@ID@ = 1

.PHONY: @ID@ @ID@-check @ID@-windows @ID@-armhf @ID@-dist @ID@-screenshots @ID@-art

@ID@:
	+$(@UP@_MAKE) host
@ID@-windows:
	+$(@UP@_MAKE) windows
@ID@-armhf:
	+$(@UP@_MAKE) armhf
@ID@-dist:
	+$(@UP@_MAKE) dist

@UP@_OBJ_HOST = $(patsubst %.c,build/host/%.o,$(wildcard $(@UP@_DIR)/src/*.c) $(HOUSE_SRC))

@ID@-check:
	+$(@UP@_MAKE) host build/host/test_libretro build/host/@ID@_test_states
	./build/host/test_libretro build/host/@ID@_libretro.so 600
	sh $(@UP@_DIR)/tests/smoke_test.sh build/host/@ID@_headless build
	sh $(@UP@_DIR)/tests/ui_test.sh build/host/@ID@_headless build/@ID@-ui
	sh $(@UP@_DIR)/tests/state_test.sh build/host/@ID@_test_states build/states
	$(PYTHON) tools/state_audit.py --game @ID@ build/host/@ID@_test_states $(@UP@_OBJ_HOST)

@ID@-screenshots:
	+$(@UP@_MAKE) build/host/@ID@_headless
	sh $(@UP@_DIR)/tests/ui_test.sh build/host/@ID@_headless $(@UP@_DIR)/docs/screenshots 2

@ID@-art:
	$(PYTHON) $(@UP@_DIR)/tools/make_art.py
