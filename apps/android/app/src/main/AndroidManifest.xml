<?xml version="1.0" encoding="utf-8"?>
<!-- RetroStone Arcade (free and full) and RetroStone Board. The package id (applicationId) and the version come from
     apps/android/app.conf, app-full.conf or app-board.conf; the Activity and its orientation too (ACTIVITY and
     ORIENTATION: app/build.gradle's manifestPlaceholders; the Arcade's: ArcadeActivity, sensorLandscape). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- OpenGL ES 2.0 (SDL's renderer) -->
    <uses-feature android:glEsVersion="0x00020000" />
    <!-- touch, Bluetooth and USB game controllers: all optional (a TV box or a handheld with a pad works too) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    <!-- controller rumble (SDL) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:appCategory="game"
        android:isGame="true"
        android:hardwareAccelerated="true"
        android:theme="@style/ArcadeTheme">

        <activity
            android:name="${activity}"
            android:label="@string/app_name"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="${orientation}"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:resizeableActivity="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- USB controllers plugged in -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
    </application>
</manifest>
